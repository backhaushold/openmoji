# 1Password secret references for the release lane (tech spec 12.2, ADR-0010).
#
# Only op:// references live here, never values, so this file is committed.
# scripts/op-run.sh passes it to `op run --env-file`, which resolves each
# reference from the `OpenMoji` vault and injects it into scripts/release.sh's
# environment for that one process. Items are created per
# docs/runbooks/testflight-release.md sections 2.3 and 2.5.
#
# Optional, not a secret so not listed below: SIGNING_KEYCHAIN_PATH overrides
# the default ~/Library/Keychains/openmoji-signing.keychain-db.

# Password of the dedicated signing keychain (runbook 2.3).
SIGNING_KEYCHAIN_PASSWORD=op://OpenMoji/openmoji-signing-keychain/password

# App Store Connect API key, role App Manager (runbook 2.5). The .p8 is stored
# base64-encoded; release.sh decodes it to a temporary file that it deletes on
# every exit path.
ASC_ISSUER_ID=op://OpenMoji/testflight-asc-api-key/issuer-id
ASC_KEY_ID=op://OpenMoji/testflight-asc-api-key/key-id
ASC_PRIVATE_KEY_BASE64=op://OpenMoji/testflight-asc-api-key/private-key-base64
